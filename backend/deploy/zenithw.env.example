SECRET_KEY=replace-with-a-long-random-value
ORIGIN_SECRET=replace-with-the-cloudflare-origin-lock-value
# Keep ALLOW_INSECURE_ORIGIN_LOCK unset in production. It is honored only when
# FLASK_ENV=development and exists solely for an explicitly insecure local run.
# Optional: set a different long random value to enable authenticated /diagnostics access.
# DIAGNOSTICS_TOKEN=replace-with-a-separate-long-random-value
ENABLE_ORIGIN_LOCK=1
TRUST_PROXY=1
PROXY_HOPS=1
YOUTUBE_POT_PROVIDER_URL=http://127.0.0.1:4416
# Hosted web temporarily sends YouTube links to the local device apps.
YOUTUBE_WEB_ENABLED=0
# Set this to the exact current User-Agent of the browser that produced
# cookies.txt. Leave unset only when YouTube cookies are not being used.
# YOUTUBE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36
FFMPEG_THREADS=1
MAX_CONCURRENT_DOWNLOADS=1
MAX_CONCURRENT_CONVERSIONS=1
MAX_CONCURRENT_INFO=2
MAX_CONCURRENT_THUMBNAILS=1
MAX_CONCURRENT_TRANSFERS=1
MAX_SOCKET_CONNECTIONS=400
MAX_SOCKET_CONNECTIONS_PER_IP=20
# Per-visitor quotas: normal browsing stays responsive; job starts remain bounded.
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=8
INFO_RATE_LIMIT_MAX_REQUESTS=12
THUMBNAIL_RATE_LIMIT_MAX_REQUESTS=15
# YouTube uses one shared AWS egress IP. These quotas count only real upstream
# work; cache hits and coalesced metadata lookups do not consume them.
YOUTUBE_RATE_LIMIT_WINDOW=60
YOUTUBE_INFO_PER_IP=6
YOUTUBE_INFO_GLOBAL=12
YOUTUBE_DOWNLOADS_PER_IP=3
YOUTUBE_DOWNLOADS_GLOBAL=8
YOUTUBE_REPEAT_COOLDOWN_SECONDS=10
MAX_SPOOL_SIZE_MB=640
MIN_FREE_DISK_MB=192
DOWNLOAD_SPOOL_RESERVATION_MB=512
MAX_DOWNLOAD_SIZE_MB=256
MAX_CONVERT_OUTPUT_SIZE_MB=192
PREPARED_FILE_TTL=300
