# Required in every non-development deployment. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-value

# Compose serves ZenithW at http://localhost:8080 by default.
ZENITHW_PORT=8080
SELF_HOSTED_ORIGIN=http://localhost:8080

# Conservative defaults for a small self-hosted server.
FFMPEG_THREADS=1
MAX_CONCURRENT_DOWNLOADS=1
MAX_CONCURRENT_CONVERSIONS=1
MAX_CONCURRENT_INFO=2
MAX_CONCURRENT_THUMBNAILS=1
MAX_CONCURRENT_TRANSFERS=1
MAX_SOCKET_CONNECTIONS=100
MAX_SOCKET_CONNECTIONS_PER_IP=10
MAX_SPOOL_SIZE_MB=1024
MIN_FREE_DISK_MB=256
DOWNLOAD_SPOOL_RESERVATION_MB=512
MAX_DOWNLOAD_SIZE_MB=512
MAX_CONVERT_OUTPUT_SIZE_MB=256
PREPARED_FILE_TTL=300

# YouTube is best-effort. Keep upstream work modest on a shared IP.
YOUTUBE_WEB_ENABLED=1
YOUTUBE_RATE_LIMIT_WINDOW=60
YOUTUBE_INFO_PER_IP=6
YOUTUBE_INFO_GLOBAL=12
YOUTUBE_DOWNLOADS_PER_IP=3
YOUTUBE_DOWNLOADS_GLOBAL=6
YOUTUBE_REPEAT_COOLDOWN_SECONDS=10

# Optional: a self-hosted PO Token provider endpoint. Leave empty to disable it.
# YOUTUBE_POT_PROVIDER_URL=http://host.docker.internal:4416
