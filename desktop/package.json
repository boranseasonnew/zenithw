{
  "name": "zenithw-desktop",
  "version": "4.1.0",
  "private": true,
  "author": "ZenithW contributors",
  "description": "Zenith — Windows media workspace",
  "main": "src/main.cjs",
  "scripts": {
    "stage-tools": "node scripts/stage-tools.cjs",
    "pack": "npm run stage-tools && electron-builder --dir --win",
    "dist": "npm run stage-tools && electron-builder --win nsis",
    "start": "npm run stage-tools && electron .",
    "portable": "npm run stage-tools && electron-builder --win portable",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "space.zenithw.desktop.stable",
    "productName": "Zenith",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Zenith-4.1.0-Windows-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZenithW",
      "uninstallDisplayName": "ZenithW 4.1.0",
      "guid": "b488ee39-dfc6-4cad-9cf7-16e068d552e3"
    },
    "portable": {
      "artifactName": "Zenith-4.1.0-Windows.exe",
      "requestExecutionLevel": "user"
    }
  }
}
