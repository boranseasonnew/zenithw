{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zenith",
  "version": "5.0.0",
  "identifier": "space.zenithw.desktop.stable",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main", "create": false, "title": "Zenith 5.0.0", "width": 1220, "height": 790,
        "minWidth": 780, "minHeight": 540, "decorations": true, "backgroundColor": "#171717",
        "url": "app.html"
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; font-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; object-src 'none'",
      "capabilities": [
        { "identifier": "main-window", "windows": ["main"], "permissions": ["core:event:allow-listen", "core:event:allow-unlisten"] }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../build/icon.ico", "../src/brand.png"],
    "resources": { "../resources/bin/": "bin/", "../LICENSE": "LICENSE", "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md" },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": ["English", "Turkish", "German", "Russian"]
      }
    }
  }
}
