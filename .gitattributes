# Preserve the bytes used by content hashes on Windows and Linux.
frontend/cache-assets/** -text
frontend/locales/*.json -text
frontend/_headers text eol=lf
frontend/_routes.json text eol=lf
scripts/cache-assets-manifest.json text eol=lf
shared/pages-cache-assets.mjs text eol=lf

# Preserve compiled byte-sensitive WASM strings and hashed assets.
frontend/cache-assets/** -text whitespace=cr-at-eol
frontend/audio-separator-worker.js -text -diff -whitespace
frontend/vendor/lilith-engine/separation-worker.js -text -diff -whitespace
